{
  "manifest_version": 3,
  "name": "DoH-Switcher // CyberDNS",
  "version": "2.0.0",
  "description": "Cyberpunk-styled instant DNS-over-HTTPS (DoH) switcher for Chromium browsers.",
  "author": "linskay",
  "homepage_url": "https://github.com/linskay/DoH-Switcher",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "DoH-Switcher // CyberDNS"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
